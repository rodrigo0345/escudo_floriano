# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# BACKEND_URL is set in docker-compose.yaml (the FireTrace Coordination API, `/api/v1`).
#
# The backend host is resolved lazily (variable + resolver): the UI container starts even if
# the backend isn't up yet, instead of crash-looping on "host not found in upstream".
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  resolver 127.0.0.11 valid=10s ipv6=off;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # API + interactive docs → backend (same origin as the UI, so the browser needs no CORS)
  location /api/ {
    set $backend ${BACKEND_URL};
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 600s;   # `Prefer: wait=<s>` long-polls and big result grids
    client_max_body_size 16m;
  }

  location /swagger {
    set $backend ${BACKEND_URL};
    proxy_pass $backend;
    proxy_set_header Host $host;
    # same XFF as /api/: otherwise the backend sees only nginx's private IP and treats docs
    # traffic as an internal service, sharing the generous internal rate-limit partition
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # photoreal 3D city: local tiles saved once by tools/fetch_tiles3d.py and mounted read-only (see docker-compose.yaml). No folder = 404 = no 3D city.
  location /tiles3d/ {
    root /usr/share/nginx;
    expires 1d;
    add_header Cache-Control "public";
    try_files $uri =404;
  }

  # hashed build assets: cache forever
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # single-page app: everything else falls back to index.html (never cache it, so a deploy is picked up at once)
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
