{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Todos os valores de modelação, limites, endereços e tempos da API estão aqui (e os do carregamento do mapa em `mapdata.settings.json`).
  // O código não tem valores por omissão: se faltar uma chave, a API não arranca.
  "FireTrace": {
    "Limits": {
      "MinDurationMinutes": 5,
      "MaxDurationMinutes": 720,
      "MinIgnitions": 1,
      "MaxIgnitions": 10,
      "MaxEnsembleMembers": 24,
      "MaxKeyframes": 500,
      "MaxActionsPerPlan": 500,
      "MaxPageSize": 200,
      "MaxWeatherDays": 31,
      "MaxWaitSeconds": 120,
      "MaxStepMinutes": 60,
      "DefaultActionWindowMinutes": 30,
      "ActionSmokeStepMinutes": 10,
      "PlanRequestStaleMinutes": 20,
      "MaxPlanRequestNoteLength": 500,
      // por IP e janela: os agentes fazem rajadas de rotas e consultas a partir de um só endereço, 300/min não chegava
      "RateLimitPermitLimit": 6000,
      "RateLimitWindowSeconds": 60,
      // criar/validar/simular/corrigir planos: 6 em simultâneo (A e B são julgados ao mesmo tempo, 3 simulações cada; a validação gasta CPU e o Docker tem 8) e 64 à espera; o validador usa o mesmo limite
      "PlanningPermitLimit": 6,
      "PlanningQueueLimit": 64,
      "PlanRequestPermitLimit": 16,
      "PlanRequestQueueLimit": 64
    },

    "Defaults": {
      "PageSize": 50,
      "SpinUpHours": 7,
      "Spotting": true,
      "Ensemble": {
        "Members": 12,
        "Seed": 1,
        "WindSpeedFactor": { "Min": 0.75, "Max": 1.25 },
        "WindDirectionSigmaDeg": 15,
        "HumidityFactor": { "Min": 0.85, "Max": 1.15 },
        "FuelMoistureFactor": { "Min": 1, "Max": 1 }
      },
      "EnsemblePreviewMembers": 12,
      "WeatherStepMinutes": 10,
      "SummaryStepMinutes": 15,
      "VectorWindowMinutes": 6,
      "MinProbability": 0.3,
      "PlaceAccessOrigin": "fire_brigade",
      "PlaceAccessStepMinutes": 3,
      "ThreatenedHorizonMinutes": 60,
      "NearbyWaterRadiusM": 3000,
      "NearbyWaterLimit": 10,
      "BuildingsLimit": 5000,
      "MinBuildings": 1,
      "SeriesStepMinutes": 60
    },

    "Engine": {
      "Url": "http://localhost:9000",
      "MetIntervalSeconds": 600,
      "HttpTimeoutMinutes": 30,
      "HealthTimeoutSeconds": 3,
      "ProgressPollSeconds": 3,
      // "native" (padrão, C# em processo, rápido) ou "elmfire" (física completa, mais fiel, muito mais lento)
      "Provider": "native",
      // Projeção de faíscas (ELMFIRE): calibrado contra o cenário da Penha (Guimarães, tecido urbano fragmentado por estradas) para que o fogo
      // respeite sobretudo as barreiras e a vegetação, com faíscas só do fogo de copas mais intenso a saltar ocasionalmente para lá delas.
      // Os valores por omissão do ELMFIRE (0 kW/m, 20%) deixavam qualquer célula em chamas projetar faíscas com probabilidade alta: o fogo
      // alastrava por quase toda a área dentro da barreira mais próxima (774 ha/3h) em vez de a atravessar só pontualmente (588 ha/3h com estes valores;
      // 21 ha/3h sem faíscas nenhumas — ver a nota em FireTrace.MapData/../memory, secção "calibração de faíscas").
      "Spotting": {
        "CriticalFirelineIntensityKwm": 10000,
        "PignPct": 2,
        "PignMinPct": 1,
        "PignMaxPct": 3,
        "EmberGenerationRate": 1.0,
        "TauEmberGenSeconds": 10,
        "EmberSamplingFactor": 50,
        // quase só o fogo de copas projeta faíscas (convenção operacional); um resíduo pequeno de fogo de superfície, não zero
        // (um valor de configuração não pode ser 0: ver SettingsTests — zero e "em falta" seriam indistinguíveis)
        "SurfaceFireSpottingPercentMin": 0.1,
        "SurfaceFireSpottingPercentMax": 0.5,
        // SEM ISTO o ELMFIRE não limita a distância de uma faísca (0 = sem tecto): com vento forte e fogo de copas intenso uma faísca podia
        // "aterrar" a vários km, criando focos isolados impossíveis. Sardoy et al. (2008, Combustion and Flame 154) — o modelo empírico que o
        // ELMFIRE usa aqui — e a litertura de projeção de faíscas em geral: a maioria das faíscas aterra a poucas centenas de metros; só em
        // incêndios de intensidade extrema (coluna de convecção, "firestorm") é que ultrapassam 1 km. Como este cenário é "muito severo" mas
        // não um firestorm, o limite fica nas centenas de metros.
        "MinSpottingDistanceM": 20,
        "MaxSpottingDistanceM": 700
      }
    },

    "Simulation": {
      "IgnitionSnapRadiusCells": 5,
      "WeatherSampleIntervalMinutes": 10,
      "WaitPollMilliseconds": 500,
      "WorkerStartPollMilliseconds": 500,
      "ProgressPercent": { "Preparing": 5, "RunningMembers": 15, "PostProcessing": 90 }
    },

    "Weather": {
      "Timeline": {
        "StepMinutes": 10,
        "MarginMinutes": 60,
        "ProviderPaddingBeforeHours": 1,
        "ProviderPaddingAfterHours": 2,
        "ProviderFallback": { "HumidityPct": 50, "TempC": 20 },
        "NoneBase": { "WindKmh": 15, "WindFromDeg": 335, "HumidityPct": 30, "TempC": 25 },
        "MinHumidityPct": 1,
        "MaxHumidityPct": 100,
        "RainSaturationHumidityPct": 95,
        "RainOvercastCloudPct": 90
      }
    },

    // Do mapa de vegetação para o ELMFIRE: o que arde, com que combustível Scott & Burgan (fbfm40) e que estrutura de copado.
    // A correspondência é uma ESCOLHA DE MODELAÇÃO (não há tabela oficial para Portugal) e deve ser calibrada com incêndios reais.
    // Eucalipto e pinheiro usam mato (SH5) sob copado: em Portugal o fogo nestes povoamentos é dominado pelo sub-bosque (giesta, tojo, urze).
    "Fuels": [
      { "Id": 0,  "Key": "sem_dados",  "Label": "Sem dados",                          "Fbfm40": 99,  "CanopyCoverPct": 0,  "CanopyHeightM": 0,  "CanopyBaseHeightM": 0,   "CanopyBulkDensity": 0,    "SpreadFactor": 1.0, "BurnMinutes": 10, "Color": "#555555" },
      { "Id": 1,  "Key": "agricola",   "Label": "Agricultura / vinha",                "Fbfm40": 101, "CanopyCoverPct": 0,  "CanopyHeightM": 0,  "CanopyBaseHeightM": 0,   "CanopyBulkDensity": 0,    "SpreadFactor": 0.15, "BurnMinutes": 3,  "Color": "#f0c08a" },
      { "Id": 2,  "Key": "pasto",      "Label": "Pasto / prado",                      "Fbfm40": 102, "CanopyCoverPct": 0,  "CanopyHeightM": 0,  "CanopyBaseHeightM": 0,   "CanopyBulkDensity": 0,    "SpreadFactor": 1.0, "BurnMinutes": 3,  "Color": "#e3d77a" },
      { "Id": 3,  "Key": "rocha",      "Label": "Rocha / solo nu",                    "Fbfm40": 99,  "CanopyCoverPct": 0,  "CanopyHeightM": 0,  "CanopyBaseHeightM": 0,   "CanopyBulkDensity": 0,    "SpreadFactor": 1.0, "BurnMinutes": 2,  "Color": "#a8a39a" },
      { "Id": 4,  "Key": "mato",       "Label": "Mato / giesta / urze",               "Fbfm40": 145, "CanopyCoverPct": 0,  "CanopyHeightM": 0,  "CanopyBaseHeightM": 0,   "CanopyBulkDensity": 0,    "SpreadFactor": 0.7, "BurnMinutes": 12, "Color": "#b5651d" },
      { "Id": 5,  "Key": "floresta",   "Label": "Floresta mista",                     "Fbfm40": 163, "CanopyCoverPct": 50, "CanopyHeightM": 16, "CanopyBaseHeightM": 4.5, "CanopyBulkDensity": 0.10, "SpreadFactor": 1.0, "BurnMinutes": 18, "Color": "#6b8f4e" },
      { "Id": 6,  "Key": "urbano",     "Label": "Urbano",                             "Fbfm40": 91,  "CanopyCoverPct": 0,  "CanopyHeightM": 0,  "CanopyBaseHeightM": 0,   "CanopyBulkDensity": 0,    "SpreadFactor": 1.0, "BurnMinutes": 8,  "Color": "#8c8c92" },
      { "Id": 7,  "Key": "agua",       "Label": "Água",                               "Fbfm40": 98,  "CanopyCoverPct": 0,  "CanopyHeightM": 0,  "CanopyBaseHeightM": 0,   "CanopyBulkDensity": 0,    "SpreadFactor": 1.0, "BurnMinutes": 1,  "Color": "#2f6fb5" },
      { "Id": 8,  "Key": "eucalipto",  "Label": "Eucaliptal (provável)",              "Fbfm40": 147, "CanopyCoverPct": 35, "CanopyHeightM": 22, "CanopyBaseHeightM": 4,   "CanopyBulkDensity": 0.10, "SpreadFactor": 1.2, "BurnMinutes": 20, "Color": "#2fb06a" },
      { "Id": 9,  "Key": "pinheiro",   "Label": "Pinhal (conífera)",                  "Fbfm40": 145, "CanopyCoverPct": 50, "CanopyHeightM": 18, "CanopyBaseHeightM": 8,   "CanopyBulkDensity": 0.08, "SpreadFactor": 0.7, "BurnMinutes": 25, "Color": "#14563a" },
      { "Id": 10, "Key": "folhosas",   "Label": "Folhosas (carvalho, castanheiro…)",  "Fbfm40": 162, "CanopyCoverPct": 70, "CanopyHeightM": 15, "CanopyBaseHeightM": 6,   "CanopyBulkDensity": 0.10, "SpreadFactor": 0.9, "BurnMinutes": 15, "Color": "#b6cf4a" }
    ],

    "Landscape": {
      "HouseFootprintM2": 125.0,
      "FirebreakFactor": 0.15,
      "DenseBuiltThreshold": 0.45,
      "BuiltAreaSpreadSlowdown": 0.7,
      "MinAdjustmentFactor": 0.02,
      "UrbanFuelModel": 91,
      "MinFlammableFuelModel": 100,
      // Calibração global da velocidade de propagação (1 = a do ELMFIRE); ajustada para ritmos de incêndios florestais portugueses.
      "SpreadCalibration": 1.0,
      // Variabilidade da propagação que a grelha de 60 m não resolve (combustível, microrrelevo): a velocidade varia 1 ± Amplitude em manchas de
      // CorrelationCells células, sempre igual para a mesma Seed. Com Amplitude 0 o terreno uniforme dá elipses perfeitas.
      "SpreadVariability": { "Amplitude": 0.4, "CorrelationCells": 3, "Seed": 7 },
      // Vegetação junto a água fresca (rios, canais, lagos): mais húmida, arde mais devagar; o efeito decai com a distância (m).
      "Riparian": { "Slowdown": 0.5, "DecayM": 80, "MaxDistanceM": 250, "WaterwayKinds": [ "river", "canal" ] },
      // Barreiras: BlockFactor = fração da propagação que passa onde a barreira trava; BaseBreach = probabilidade de uma mancha (PatchCells) ser galgada
      // com vento fraco; WindSensitivity multiplica o aumento por km/h acima do limiar. Uma mancha galgada só deixa passar LeakFactor.
      "Barriers": {
        "LeakFactor": 0.5,
        "PatchCells": 3,
        "WindThresholdKmh": 15,
        "BreachPerKmh": 0.02,
        "MaxBreach": 0.6,
        // Para mostrar no mapa: força 1 + o número de limites que o fator de bloqueio da classe não passa (≤ 0,25 = bastante, ≤ 0,06 = quase total).
        "StrengthLimits": [ 0.25, 0.06 ],
        // BlockFactor aplica-se à célula de 60 m inteira que a via toca (sem reentrância pela largura real). Uma autoestrada tem faixa de
        // rodagem larga MAIS uma faixa de domínio público limpa de vegetação (habitualmente >20 m), pelo que "toda a célula é quase sem
        // combustível" é razoável. Uma rua residencial tem 5-8 m de piso: o resto da célula de 60 m é jardim, quintal ou terreno com
        // combustível igual ao que a rodeia. Tratá-la como a autoestrada exagerava a barreira ~8-10×; os valores abaixo escalam o travão
        // pela largura típica de cada classe (OSM highway=*) relativa a uma célula de 60 m.
        // Recalibrado para células de 30 m (Guimarães passou de 60 m): o mesmo troço real cobre o dobro da fração da célula, logo trava mais.
        // Os BlockFactor abaixo são ao quadrado dos de 60 m (survival_fraction² ≈ dobrar a largura relativa) e BaseBreach desceu um pouco.
        "Roads": {
          "motorway":      { "BlockFactor": 0.004, "BaseBreach": 0.02, "WindSensitivity": 1.0 },
          "motorway_link": { "BlockFactor": 0.006, "BaseBreach": 0.02, "WindSensitivity": 1.0 },
          "trunk":         { "BlockFactor": 0.005, "BaseBreach": 0.03, "WindSensitivity": 1.0 },
          "trunk_link":    { "BlockFactor": 0.01,  "BaseBreach": 0.03, "WindSensitivity": 1.0 },
          "primary":       { "BlockFactor": 0.02,  "BaseBreach": 0.06, "WindSensitivity": 1.0 },
          "primary_link":  { "BlockFactor": 0.04,  "BaseBreach": 0.06, "WindSensitivity": 1.0 },
          "secondary":     { "BlockFactor": 0.10,  "BaseBreach": 0.10, "WindSensitivity": 1.0 },
          "secondary_link":{ "BlockFactor": 0.13,  "BaseBreach": 0.10, "WindSensitivity": 1.0 },
          "tertiary":      { "BlockFactor": 0.31,  "BaseBreach": 0.15, "WindSensitivity": 1.0 },
          "tertiary_link": { "BlockFactor": 0.36,  "BaseBreach": 0.15, "WindSensitivity": 1.0 },
          "unclassified":  { "BlockFactor": 0.61,  "BaseBreach": 0.25, "WindSensitivity": 1.0 },
          "residential":   { "BlockFactor": 0.77,  "BaseBreach": 0.32, "WindSensitivity": 1.0 },
          "living_street": { "BlockFactor": 0.81,  "BaseBreach": 0.32, "WindSensitivity": 1.0 }
        },
        // Um rio largo só é galgado por faíscas com vento muito forte; uma ribeira, seca no verão, trava pouco.
        "Waterways": {
          "river":  { "BlockFactor": 0.02, "BaseBreach": 0.0,  "WindSensitivity": 0.3 },
          "canal":  { "BlockFactor": 0.03, "BaseBreach": 0.0,  "WindSensitivity": 0.3 },
          "stream": { "BlockFactor": 0.50, "BaseBreach": 0.50, "WindSensitivity": 1.0 },
          "drain":  { "BlockFactor": 0.90, "BaseBreach": 0.90, "WindSensitivity": 1.0 }
        }
      }
    },

    // Efeito do fogo no vento (convecção): a coluna puxa ar para o fogo; depois de correr o motor, recalcula-se o vento e corre-se de novo.
    // Motor nativo (Provider=native): Rothermel (1972) completo por modelo de combustível Scott & Burgan, vento a meio da chama (WAF de Andrews),
    // declive e vento somados como vetores, frente elíptica de Huygens/tempo mínimo de viagem, Byram e Van Wagner para o fogo de copas.
    // A calibração local (`SpreadCalibration`) multiplica a velocidade depois da física; as restantes entradas são limiares físicos, não afinadores.
    "NativeEngine": {
      // 1 = sem calibração; a humidade, o combustível e o vento já vêm da física. Sobe-se só se uma validação local com fogos observados o pedir.
      "SpreadCalibration": 1.0,
      // Piso do fator de ajuste do vento: copados muito fechados não podem reduzir o vento a zero (heterogeneidade não resolvida na grelha).
      "MinWindAdjustmentFactor": 0.05,
      // As condições de uma célula são recalculadas no máximo uma vez por este intervalo (min): a frente passa por muitas arestas no mesmo minuto.
      "BehaviorBucketMinutes": 5,
      // Quantos pontos percentuais de humidade o combustível fino perde numa encosta virada a sul (e ganha a norte).
      "AspectMoistureSwingPct": 4.0,
      // Alongamento máximo da elipse vento+declive (Behave usa 8 como teto físico).
      "MaxLengthToWidthRatio": 8.0,
      // Fogo de copas (Van Wagner 1977/1993): cobertura mínima, limiar de intensidade e critério de copa ativa.
      "MinCrownCoverPct": 10,
      "CrownFireRosFactor": 3.34,
      "CriticalCrownRosFactor": 3.0,
      "CrownHeatContentKjKg": 18622,
      // (Já não usado: a fração de copa que arde é agora contínua, ver CrownFractionBurnedRate.)
      "PassiveCrownFuelFraction": 0.25,
      // Fração de copa que arde (Van Wagner 1993 / sistema FBP): CFB = 1 − e^(−k·(R − R0)), R0 a velocidade de superfície na iniciação; k por m/min.
      // Um fogo pouco acima do limiar faz tochas isoladas, um muito acima leva a copa toda: sem o salto de 25% para 100% que dava 30–47 MW/m em todas as copas.
      "CrownFractionBurnedRate": 0.23,
      // Combustível de copa disponível (folhagem e ramos finos), kg/m²: densidade × comprimento da copa sobrestima-o; povoamentos reais ~0,5–2 (Scott & Reinhardt 2001).
      "MaxCanopyFuelLoadKgM2": 1.5,
      // Entra na chave da cache de resultados: sobe quando o código da física muda (2 = fração de copa ardida contínua e carga de copa limitada).
      "PhysicsRevision": 2,
      "DefaultFoliarMoisturePct": 100,
      // Chuva: abaixo de RainStartMmH não trava; a partir de RainExtinctionMmH extingue a propagação; no meio, linear.
      "RainStartMmH": 0.5,
      "RainExtinctionMmH": 4.0,
      // Fração da rajada (gust − vento médio) que entra no vento efetivo: as rajadas comandam as corridas, mas não todo o tempo.
      "GustFactor": 0.5
    },

    "Convection": {
      "Enabled": true,
      "Passes": 1,
      "BlockM": 300,
      "ActiveWindowMinutes": 30,
      "InflowDecayM": 300,
      "InflowRangeFactor": 3,
      "InflowEfficiency": 0.25,
      "GravityMs2": 9.81,
      "HeatCapacityJm3": 360000,
      // O ar puxado pelo fogo nunca passa de MaxInducedFraction do vento do tempo (mínimo MinInducedCapKmh, máximo MaxInducedKmh): o vento do tempo manda, o fogo só o curva.
      "MaxInducedKmh": 12,
      "MaxInducedFraction": 0.35,
      "MinInducedCapKmh": 3,
      "MinIntensityKwm": 500
    },

    "FuelMoisture": {
      "LiveHerbaceousPct": 40,
      "LiveWoodyPct": 80,
      "Dead1hPct": 6,
      "Dead10hPct": 8,
      "Dead100hPct": 10,
      "TimeLag1hMinutes": 60,
      "TimeLag10hMinutes": 600,
      "TimeLag100hMinutes": 6000,
      "EquilibriumSampleMinutes": 30,
      "MinEquilibriumMoisture": 0.02,
      "MaxEquilibriumMoisture": 0.40,
      "MinDeadMoisturePct": 2,
      "RainSaturationPct": 35,
      "RainIntercept1hMm": 0.5,
      "RainIntercept10hMm": 3,
      "RainIntercept100hMm": 10,
      "SolarHeatingMaxC": 8,
      "SolarReferenceWm2": 1000
    },

    "Interventions": {
      "MinSpreadFactor": 0.02,
      "AerialLineBufferM": 90,
      "AerialDefaultEffectMinutes": 30,
      // Linha de contenção aberta à mão, por pessoa (o corte de árvores de FuelRemoval é bem mais lento): valor de partida, a calibrar com as corporações.
      "FireLineRateMPerHourPerPerson": 30,
      "StructureProtectionRadiusM": 250,
      // Uma linha de contenção pronta trava o fogo que lhe chega (na direção em que chega: um flanco é muito mais fraco que a cabeça) até LineHoldFullKwm
      // (~2,5 m de chama, Byram) e é ultrapassada a partir de LineBreachKwm (chamas mais altas que a largura da linha, projeções), linear entre os dois.
      "LineHoldFullKwm": 3500,
      "LineBreachKwm": 10000,
      // Corte de árvores/mato em faixa: o arvoredo retirado tira o fogo de copas e abranda a propagação; sem sub-bosque trava mais; "all" deixa solo nu.
      "FuelRemoval": { "DefaultWidthM": 20, "TreesSpreadFactor": 0.6, "UnderstorySpreadFactor": 0.35, "UnderstoryFuelModel": 101, "NonBurnableFuelModel": 99, "CrewRateMPerHourPerPerson": 15 }
    },

    "Analytics": {
      "VectorBlockCells": 5,
      "VectorMinGradient": 0.05,
      "VectorMinSpeedGradient": 0.2,
      "VectorMinSamplesPerBlock": 3,
      "VectorMinDirectionConsistency": 0.3,
      "HeadTrimFraction": 0.1,
      "HeadFraction": 0.25,
      "PerimeterSimplifyTolerance": 0.35,
      "IntensityWindowMinutes": 10,
      "SlowAccessFactor": 1.25,
      "SlowAccessExtraMinutes": 1,
      "AtRiskProbability": 0.2,
      "MemberSamplePercentile": { "Low": 0.1, "High": 0.9 }
    },

    "Smoke": {
      "BlockCells": 5,
      "PlumeBaseHeightM": 80,
      "PlumeHeightPerSqrtKwm": 160,
      "PlumeReferenceKwm": 1000,
      "CrownHeightFactor": 1.5,
      "DriftHours": 1.0,
      "MinDriftKm": 2,
      "MaxDriftKm": 25,
      "DriftSpeedFactor": 0.8,
      "CorridorWidthM": 1500,
      "MaxAffectedRoads": 200,
      // Fumo por nuvens gaussianas. Emissão: g/s = I(kW/m)·célula(m) / calor de combustão(kJ/kg) · fator de emissão de PM2.5 (g/kg). Visibilidade = 3,912 / (extinção · C).
      "Dispersion": {
        "FieldBlockM": 120,
        "PuffStepMinutes": 1,
        "PuffLifetimeMinutes": 120,
        "FlameMinutes": 8,
        "HeatOfCombustionKjKg": 18000,
        "EmissionFactorGPerKg": 12,
        "LowLevelFraction": 0.15,
        "SourceSigmaM": 120,
        "SourceSigmaZRatio": 0.25,
        "CalmDiffusionMs": 0.5,
        "AloftWindFactor": 1.3,
        "MixingHeightDayM": 1800,
        "MixingHeightNightM": 400,
        "MixedLayerSigmaRatio": 0.8,
        "MassExtinctionM2g": 8,
        "ClearVisibilityM": 20000,
        // Limites das classes de visibilidade (m): 1 = neblina, 2 = reduzida, 3 = fraca, 4 = densa.
        "VisibilityClassesM": [ 5000, 1000, 300, 100 ],
        "QueryDefaultStepMinutes": 5,
        "MaxQueryPoints": 200,
        "RoadSamplePoints": 12,
        "Stability": { "DayStartHour": 8, "DayEndHour": 18, "UnstableBelowMs": 2, "SlightlyUnstableBelowMs": 5, "NightStableBelowMs": 3 },
        "Briggs": {
          "unstable":          { "AY": 0.22, "BY": 0.0001, "AZ": 0.20, "BZ": 0,      "EZ": 0 },
          "slightly_unstable": { "AY": 0.16, "BY": 0.0001, "AZ": 0.12, "BZ": 0,      "EZ": 0 },
          "neutral":           { "AY": 0.11, "BY": 0.0001, "AZ": 0.08, "BZ": 0.0015, "EZ": -0.5 },
          "stable":            { "AY": 0.06, "BY": 0.0001, "AZ": 0.03, "BZ": 0.0003, "EZ": -1 }
        }
      }
    },

    "Routing": {
      "RoadTypicalSpeedKmh": {
        "motorway": 120, "trunk": 90, "primary": 80, "secondary": 70, "tertiary": 60, "unclassified": 50,
        "residential": 40, "living_street": 20, "service": 30, "track": 25, "path": 10
      },
      "UnknownRoadSpeedKmh": 30,
      "MaxReroutes": 5,
      "DefaultBufferM": 150,
      "RoadStatusWarningMinutes": 30,
      "AerialDefaultKmh": 180,
      "MaxSnapM": 500,
      "WalkKmh": 3,
      "RouteToleranceM": 60,
      "PositionToleranceM": 100,
      "TrackTypeSpeedKmh": { "grade1": 50, "grade2": 35, "grade3": 22, "grade4": 14, "grade5": 8 },
      "UnpavedVehicleFactor": {
        "all_terrain_patrol": 1.0, "forest_firefighting_vehicle": 0.9, "light_firefighting_vehicle": 0.9, "tanker_forest": 0.75, "tanker_large": 0.6,
        "bulldozer": 1.0, "heavy_machinery": 1.0, "tractor_plow": 1.0, "default": 0.7
      },
      "IntersectionDelaySeconds": {
        "motorway": 0, "trunk": 1, "primary": 2, "secondary": 2, "tertiary": 3, "unclassified": 3, "residential": 4, "living_street": 5, "service": 4, "track": 3, "path": 3, "default": 3
      },
      "LateralAccelMps2": 2.5,
      "MinCurveSpeedKmh": 12,
