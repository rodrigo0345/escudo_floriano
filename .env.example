# ==============================================================================
# FireTrace Coordination Environment Configuration
# ==============================================================================

# Database settings
POSTGRES_DB=firetrace
POSTGRES_USER=firetrace
POSTGRES_PASSWORD=firetrace

# Exposed host ports
PORT_DB=5440
PORT_API=8080
PORT_WEB=8081

# Only nginx may supply X-Forwarded-For to the API. Its fixed address must lie in this subnet.
# Change both if this range overlaps another local Docker network.
FIRETRACE_PROXY_SUBNET=172.30.250.0/24
FIRETRACE_PROXY_IP=172.30.250.10

# ELMFIRE ensemble workers (parallel simulation threads)
WORKERS=8

# ==============================================================================
# Planning agents (agents/ service)
# ==============================================================================

# F6: number of candidate plans the agents generate and the engine judges (best kept).
# 1 = no comparison (faster); 2 = the demo shows "the agents compared candidate plans"
# (each extra candidate costs ~75 s of wall clock).
AGENTS_CANDIDATES=2

# Planning commander: "llm" adds an LLM candidate for the engine to judge against
# the rules-based candidates. "rules" is the default and fallback when no key/model
# is configured. Keep real credentials in your own .env.
AGENTS_COMMANDER=rules
AGENTS_LLM_BASE_URL=https://api.openai.com/v1
AGENTS_LLM_MODEL=
OPENAI_API_KEY=
