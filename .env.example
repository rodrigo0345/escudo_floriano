# ==============================================================================
# FireTrace Coordination Environment Configuration
# ==============================================================================

# Database settings
POSTGRES_DB=firetrace
POSTGRES_USER=firetrace
POSTGRES_PASSWORD=firetrace

# Exposed host ports
PORT_DB=5440
PORT_API=8080
PORT_WEB=8081

# ELMFIRE ensemble workers (parallel simulation threads)
WORKERS=8

# Planning agents: who decides the plans. `rules` (default) or `llm`: an LLM commander (Bombeiros, Protecao Civil, GNR, INEM) makes one more candidate plan that the
# engine judges against the rules'. It needs the key and a model your OpenAI project may use; without them the rules decide. Keep the real values in your own .env.
AGENTS_COMMANDER=rules
AGENTS_LLM_MODEL=
OPENAI_API_KEY=
